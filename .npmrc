auto-install-peers = true
force-legacy-deploy=true
# node-linker=hoisted, NOT shamefully-hoist.
#
# Amplify's Next.js compute bundler cannot handle pnpm's symlinked
# node_modules. With the default isolated linker it walks
# apps/admin/node_modules/next, sees a symlink, and tries to recreate it
# inside its bundle output where the path already exists:
#
#   !!! We failed to bundle your application due to an unexpected error.
#   Error: EEXIST: file already exists, symlink
#     '../../../node_modules/.pnpm/next@16.3.1_.../node_modules/next'
#     -> '.../amplify-compute-bundle-output/compute/default/node_modules/next'
#
# shamefully-hoist does NOT fix this: it hoists, but the entries it creates
# are still symlinks. node-linker=hoisted writes real directories, and hoists
# far enough that apps/admin/node_modules/next stops existing at all, so
# there is no symlink left for the bundler to trip on.
#
# Verified under pnpm 8.15.6 (the version packageManager pins and both CI and
# Amplify use); local pnpm 11 ignores pnpm settings in .npmrc entirely, so
# reproduce with `corepack pnpm@8.15.6 install`, not a bare `pnpm install`.
node-linker=hoisted
