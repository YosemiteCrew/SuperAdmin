{
  "private": true,
  "name": "superadmin",
  "packageManager": "pnpm@8.15.6",
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "migrate:deploy": "pnpm --filter @superadmin/database run migrate:deploy",
    "release": "pnpm run migrate:deploy && pnpm run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "verify": "pnpm run lint && pnpm run type-check && pnpm run test:ci && pnpm run build",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint --edit",
    "check:secrets": "secretlint \"**/*\" --maskSecrets",
    "check:staged-secrets": "node scripts/check-staged-secrets.js",
    "check:overrides": "pnpm --filter admin exec node scripts/check-pnpm-overrides.mjs"
  },
  "pnpm": {
    "overrides": {
      "axios@1": ">=1.20.0 <2",
      "axios@>=1.0.0 <1.16.0": ">=1.16.0 <2",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6 <5",
      "turbo@<2.9.14": ">=2.9.14 <3",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3 <11",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7 <10",
      "minimatch@<3.1.4": ">=3.1.4 <4",
      "ajv@>=4.0.0 <6.14.0": ">=6.14.0 <7",
      "flatted@<3.4.2": ">=3.4.2 <4",
