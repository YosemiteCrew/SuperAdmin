    "@babel/core@<7.29.6": "Security floor added by the dependency remediation in 98912cd.",
    "sharp@<=0.35.0": "Security pin added by the dependency remediation in 98912cd.",
    "nodemailer@8": "AIKIDO-2026-645479: supertokens-node@24.0.3 declares nodemailer@^8.0.2 and no published release bumps to >=10.0.2; override forces the patched floor.",
    "jose@<=6.2.5": "Security pin added in 78b1752.",
    "js-yaml@<4.3.1": "Security floor added in 78b1752.",
    "postcss@<8.5.23": "Security floor added in 78b1752.",
    "fast-uri@>=3.0.0 <3.1.5": "Security floor added in 78b1752.",
    "deepmerge-ts@<8.0.0": "Security floor added in 6fe3907.",
    "adm-zip@<0.6.0": "GHSA-xcpc-8h2w-3j85 remediation added in 698d6d9; GHSA-vwc7-r8mq-g2x9 has no patched release as of 2026-09-09.",
    "qs@<6.16.0": "Security floor added in 698d6d9.",
    "mysql2@<3.22.0": "GHSA-3f6p-5ww8-9rcr remediation (dependency-review blocked PR #380): @prisma/dev - Prisma 7's local dev-database CLI, pulled in by the Prisma 7 migration - bundles a MySQL driver alongside its Postgres one even though this repo only ever connects via @prisma/adapter-pg. The vulnerable auth downgrade path is unreachable here, but the package still ships in the tree at the pinned version, which is what dependency-review checks."
  },
