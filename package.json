      "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3 <3",
      "picomatch@>=2.0.0 <2.3.2": ">=2.3.2 <3",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4 <5",
      "@babel/core@<7.29.6": ">=7.29.6",
      "sharp@<=0.35.0": "0.35.0",
      "nodemailer@8": "10.0.2",
      "jose@<=6.2.5": "6.2.5",
      "js-yaml@<4.3.1": ">=4.3.1 <5",
      "postcss@<8.5.23": ">=8.5.23 <9",
      "fast-uri@>=3.0.0 <3.1.5": ">=3.1.5 <4",
      "deepmerge-ts@<8.0.0": ">=8.0.0 <9",
      "adm-zip@<0.6.0": ">=0.6.0 <0.7",
      "qs@<6.16.0": ">=6.16.0 <7",
      "mysql2@<3.22.0": ">=3.22.0 <4"
    }
  },
  "overrideReasons": {
    "axios@>=1.0.0 <1.16.0": "Security floor added in 06fe464.",
    "form-data@>=4.0.0 <4.0.6": "Security floor added in 06fe464.",
    "turbo@<2.9.14": "Security floor added in 06fe464.",
    "minimatch@>=10.0.0 <10.2.3": "Security floor added in 06fe464.",
    "minimatch@>=9.0.0 <9.0.7": "Security floor added in 4b6479e.",
    "minimatch@<3.1.4": "Security floor added in 4b6479e.",
    "axios@<=1.18.0": "Compatibility pin added in 68128ba; keep distinct from the older axios security floor until resolution proves otherwise.",
    "ajv@>=4.0.0 <6.14.0": "Security floor added in 4b6479e.",
    "flatted@<3.4.2": "Security floor added in 4b6479e.",
    "brace-expansion@<1.1.13": "Security floor added in 4b6479e.",
