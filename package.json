{
  "private": true,
  "name": "superadmin",
  "packageManager": "pnpm@8.15.6",
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "migrate:deploy": "pnpm --filter @superadmin/database run migrate:deploy",
    "release": "pnpm run migrate:deploy && pnpm run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "verify": "pnpm run lint && pnpm run type-check && pnpm run test:ci && pnpm run build",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint --edit",
    "check:secrets": "secretlint \"**/*\" --no-gitignore --maskSecrets",
    "check:staged-secrets": "node scripts/check-staged-secrets.js",
    "check:overrides": "pnpm --filter admin exec node scripts/check-pnpm-overrides.mjs"
  },
  "pnpm": {
    "overrides": {
      "axios@1": ">=1.20.0 <2",
      "axios@>=1.0.0 <1.16.0": ">=1.16.0 <2",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6 <5",
      "turbo@<2.9.14": ">=2.9.14 <3",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3 <11",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7 <10",
      "minimatch@<3.1.4": ">=3.1.4 <4",
      "ajv@>=4.0.0 <6.14.0": ">=6.14.0 <7",
      "flatted@<3.4.2": ">=3.4.2 <4",
      "brace-expansion@<1.1.13": ">=1.1.13 <2",
      "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3 <3",
      "picomatch@>=2.0.0 <2.3.2": ">=2.3.2 <3",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4 <5",
      "@babel/core@<7.29.6": ">=7.29.6",
      "sharp@<=0.35.0": "0.35.0",
      "nodemailer@<10.0.9": ">=10.0.9 <11",
      "jose@<=6.2.5": "6.2.5",
      "js-yaml@<4.3.1": ">=4.3.1 <5",
      "postcss@<8.5.23": ">=8.5.23 <9",
      "fast-uri@>=3.0.0 <3.1.8": ">=3.1.8 <4",
      "deepmerge-ts@<8.0.0": ">=8.0.0 <9",
      "adm-zip@<0.6.1": ">=0.6.1 <0.7",
      "qs@<6.16.0": ">=6.16.0 <7",
      "mysql2@<3.22.0": ">=3.22.0 <4"
    }
  },
  "overrideReasons": {
    "axios@>=1.0.0 <1.16.0": "Security floor added in 06fe464.",
    "form-data@>=4.0.0 <4.0.6": "Security floor added in 06fe464.",
    "turbo@<2.9.14": "Security floor added in 06fe464.",
    "minimatch@>=10.0.0 <10.2.3": "Security floor added in 06fe464.",
    "minimatch@>=9.0.0 <9.0.7": "Security floor added in 4b6479e.",
    "minimatch@<3.1.4": "Security floor added in 4b6479e.",
    "axios@1": "Security floor from the axios 1.18.0 -> 1.20.0 hardening update in 56c5b56; it replaced the 68128ba compatibility pin, and a range selector reaches every axios 1.x consumer (twilio, sonarqube-scanner).",
    "ajv@>=4.0.0 <6.14.0": "Security floor added in 4b6479e.",
    "flatted@<3.4.2": "Security floor added in 4b6479e.",
    "brace-expansion@<1.1.13": "Security floor added in 4b6479e.",
    "brace-expansion@>=2.0.0 <2.0.3": "Security floor added in 4b6479e.",
    "picomatch@>=2.0.0 <2.3.2": "Security floor added in 4b6479e.",
    "picomatch@>=4.0.0 <4.0.4": "Security floor added in 4b6479e.",
    "@babel/core@<7.29.6": "Security floor added by the dependency remediation in 98912cd.",
    "sharp@<=0.35.0": "Security pin added by the dependency remediation in 98912cd.",
    "nodemailer@<10.0.9": "AIKIDO-2026-499819: supertokens-node@24.0.3 declares nodemailer@^8.0.2 and no published release bumps to >=10.0.9; override forces the patched floor. Supersedes the >=10.0.2 floor from AIKIDO-2026-645479.",
    "jose@<=6.2.5": "Security pin added in 78b1752.",
    "js-yaml@<4.3.1": "Security floor added in 78b1752.",
    "postcss@<8.5.23": "Security floor added in 78b1752.",
    "fast-uri@>=3.0.0 <3.1.8": "AIKIDO-2026-662928: fast-uri is transitive under ajv@8.20.0 (^3.0.1); percent-encoded host normalisation is fixed in 3.1.8. Raises the >=3.1.5 floor added in 78b1752.",
    "deepmerge-ts@<8.0.0": "Security floor added in 6fe3907.",
    "adm-zip@<0.6.1": "GHSA-7q85-xj36-vmfc and GHSA-vwc7-r8mq-g2x9: adm-zip is transitive under sonarqube-scanner; 0.6.1 is the first release outside both advisories. Raises the >=0.6.0 floor (GHSA-xcpc-8h2w-3j85) added in 698d6d9.",
    "qs@<6.16.0": "Security floor added in 698d6d9.",
    "mysql2@<3.22.0": "GHSA-3f6p-5ww8-9rcr remediation (dependency-review blocked PR #380). mysql2 is a direct dependency of the prisma CLI at 7.10.0, alongside postgres and @prisma/dev, for the local dev-database commands. Nothing here connects to MySQL - the panel queries Postgres through @prisma/adapter-pg - so the vulnerable auth downgrade path is unreachable, but the package still ships in the tree at the pinned version, which is what dependency-review reads."
  },
  "overrideResolutionEffects": {
    "axios@>=1.0.0 <1.16.0": false,
    "form-data@>=4.0.0 <4.0.6": false,
    "turbo@<2.9.14": false,
    "minimatch@>=10.0.0 <10.2.3": false,
    "minimatch@>=9.0.0 <9.0.7": false,
    "minimatch@<3.1.4": false,
    "axios@1": true,
    "ajv@>=4.0.0 <6.14.0": false,
    "flatted@<3.4.2": false,
    "brace-expansion@<1.1.13": false,
    "brace-expansion@>=2.0.0 <2.0.3": false,
    "picomatch@>=2.0.0 <2.3.2": false,
    "picomatch@>=4.0.0 <4.0.4": true,
    "@babel/core@<7.29.6": true,
    "sharp@<=0.35.0": false,
    "nodemailer@<10.0.9": true,
    "jose@<=6.2.5": true,
    "js-yaml@<4.3.1": true,
    "postcss@<8.5.23": false,
    "fast-uri@>=3.0.0 <3.1.8": false,
    "deepmerge-ts@<8.0.0": true,
    "adm-zip@<0.6.1": true,
    "qs@<6.16.0": false,
    "mysql2@<3.22.0": true
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.33.0",
    "@secretlint/secretlint-rule-no-dotenv": "^13.0.5",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "eslint": "^9.33.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "secretlint": "^13.0.5",
    "sonarqube-scanner": "^5.0.0",
    "turbo": "^2.10.13",
    "typescript-eslint": "^8.70.0"
  }
}
