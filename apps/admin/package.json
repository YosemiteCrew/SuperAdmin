{
  "name": "admin",
  "private": true,
  "scripts": {
    "predev": "node ./scripts/clean-dev-cache.mjs",
    "dev": "next dev --turbopack",
    "dev:clean": "rm -rf .next .turbo && next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "node ./scripts/run-jest.mjs",
    "test:unit": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci",
    "test:coverage": "jest --coverage",
    "sonar": "node ./scripts/sonar.mjs",
    "sonar:full": "pnpm test:coverage && pnpm sonar",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@superadmin/database": "workspace:^",
    "clsx": "^2.1.1",
    "next": "16.3.5",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "5.7.0",
    "supertokens-auth-react": "^0.51.3",
    "supertokens-node": "^24.0.3",
    "supertokens-web-js": "^0.16.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@superadmin/types": "workspace:^",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16",
    "eslint-plugin-sonarjs": "^4.2.1",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6"
  }
}
