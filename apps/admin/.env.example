# Copy to .env.local and fill in. Every var marked required is validated at
# startup: the app refuses to boot and names the missing one.

# --- Required ---

# Origin the panel is served from. Must be https outside local development.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# SuperTokens core.
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=

# Postgres for Prisma. Contact requests, the consent ledger and privacy
# requests all read through this; the panel signs in fine without it and then
# fails on exactly those pages, so treat it as required.
# Run `pnpm --filter @superadmin/database run migrate:deploy` after setting it.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/superadmin

# --- Optional ---

# Comma-separated emails granted the super-admin role on first sign-in.
SUPERADMIN_BOOTSTRAP_EMAILS=

# Plunk, for newsletter and campaign delivery.
PLUNK_API_KEY=
PLUNK_API_ENDPOINT=https://api.useplunk.com

# ActivityPub federation. Token issuance stays disabled while unset.
# AP_SIGNING_KEY_ID is a key identifier, not a secret; leave it blank to take
# the built-in default in config/env.server.ts.
AP_SIGNING_KEY=
AP_SIGNING_KEY_ID=

# Shared secrets for the public intake endpoints. Each endpoint refuses every
# request while its key is unset, so the marketing site's contact form and the
# apps' consent reporting silently drop until these are filled in.
CONTACT_INTAKE_KEY=
CONSENT_INTAKE_KEY=

# Social poster (TikTok). All four are needed before the Social page will do
# anything; while any is unset the page lists exactly which, and the rest of the
# panel boots normally.
#   TIKTOK_REDIRECT_URI must match a redirect registered on the TikTok app, and
#   TikTok rejects localhost — use the panel's real https origin.
#   SOCIAL_TOKEN_KEY encrypts the stored OAuth tokens at rest. Generate with
#   `openssl rand -hex 32`. Changing it later forces a reconnect.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
SOCIAL_TOKEN_KEY=

# Shared secret for unattended posting. A super-admin session cannot be used on
# a timer (the panel requires TOTP), so the scheduler authenticates to
# /api/social/tiktok/scheduled with this instead. The endpoint refuses every
# request while it is unset.
SOCIAL_SCHEDULER_KEY=
