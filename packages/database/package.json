{
  "name": "@superadmin/database",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "migrate:dev": "node scripts/assert-schema.js && prisma migrate dev",
    "migrate:deploy": "node scripts/assert-schema.js && prisma migrate deploy",
    "assert-rls": "prisma db execute --file scripts/assert-rls.sql --schema prisma/schema.prisma",
    "studio": "prisma studio",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .js,.jsx,.ts,.tsx --ignore-pattern 'src/generated/**'",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "prisma": "^6.0.0",
    "typescript": "^5"
  }
}
