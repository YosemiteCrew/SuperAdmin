// Prisma schema for the SuperAdmin panel.
// Run `pnpm --filter @superadmin/database run generate` after changes.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ActivityPub federation license tokens.
// Issued by SuperAdmin to verified organizations so their self-hosted PIMS
// instances can federate with the Yosemite Crew cloud via the AP protocol.
// Clinic federation directory listings.
// Explicit opt-in: a clinic can be license-verified and federating without
// being listed. Only public actor-profile-level fields are stored - the
// GET /api/directory payload must never expand beyond these.
model DirectoryListing {
  orgId          String   @id
  listed         Boolean  @default(false)
  actorUri       String
  orgName        String
  instanceHost   String
  handle         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([listed])
}

model APLicenseToken {
  id             String    @id @default(cuid())
  orgId          String
  instanceDomain String
  // The signed RS256 JWT — stored so it can be re-served without re-signing.
  token          String    @db.Text
  keyId          String
  tier           String
  issuedAt       DateTime
  expiresAt      DateTime
  revokedAt      DateTime?
  // userId of the super-admin who revoked the token.
  revokedBy      String?

  @@index([orgId])
  @@index([instanceDomain])
  @@index([revokedAt])
}
