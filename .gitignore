.DS_Store
node_modules
.turbo
*.log
.next
dist
dist-ssr
*.local
# env files (can opt-in for committing if needed). Mirrors apps/admin/.gitignore:
# a pattern with no slash matches at every depth, so this covers packages/* too.
# The previous three lines left .env.production and .env.staging stageable by a
# plain `git add -A`, at the root and in every package.
.env*
# ...except the template the README points at, which holds no real values.
!.env.example
.cache
public/dist

tsconfig.tsbuildinfo
tsconfig.build.tsbuildinfo

# coverage
**/coverage/

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# SonarQube
**/.scannerwork
# Local Sonar issue fetch — token file and fetched output (never commit)
.sonar-token
sonar-issues.json

# Agent output
.tmp/agent-output/
.claude/settings.local.json

# Storybook
build-storybook.log
storybook-static/
chromatic.log

# Next.js
.next/
out/

# Claude Code session state — keep local
.claude/

# Playwright output: local run artifacts, never committed.
# error-context.md can capture page snapshots from a failed run, which on an
# auth spec would be the filled sign-in form.
test-results/
playwright-report/
blob-report/
playwright/.cache/
